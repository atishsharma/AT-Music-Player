{
  "name": "at-music-pro",
  "productName": "AT Music Pro",
  "private": true,
  "version": "1.3.0",
  "description": "Premium music player with Last.fm and YouTube integration",
  "author": "Atish Ak Sharma <mail@atishaksharma.com>",
  "homepage": "https://github.com/atishsharma/At-Music-Pro",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "build": "tsc && vite build",
    "icons": "python3 scripts/generate-icons.py",
    "binaries": "node scripts/download-binaries.js",
    "download-binaries": "node scripts/download-binaries.js",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "build:win": "npm run dist:win",
    "build:mac": "npm run dist:mac",
    "build:linux": "npm run dist:linux",
    "postinstall": "electron-builder install-app-deps",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "better-sqlite3": "^12.6.2",
    "music-metadata": "^11.12.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "framer-motion": "^12.34.2",
    "lucide-react": "^0.574.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "3.4",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "zustand": "^5.0.11"
  },
  "main": "dist-electron/main.js"
}
