// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.atmusic.pro",
  "afterPack": "./scripts/afterPack.cjs",
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*",
    "node_modules/yt-dlp-exec/**/*",
    "node_modules/fluent-ffmpeg/**/*",
    "node_modules/ffmpeg-static/**/*",
    "node_modules/@ffmpeg-installer/**/*",
    "node_modules/@img/**/*"
  ],
  "productName": "AT Music Pro",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "node_modules"
  ],
  "extraResources": [
    {
      "from": "public/icon_square.png",
      "to": "app_icon.png"
    },
    {
      "from": "bin",
      "to": "bin"
    }
  ],
  "mac": {
    "target": ["zip"],
    "icon": "public/icon_square.png",
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon_square.png",
    "artifactName": "${productName}-Windows-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "flatpak",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "snap",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "AudioVideo",
    "icon": "public/icon_square.png",
    "artifactName": "${productName}-Linux-${version}.${ext}",
    "executableName": "at-music-pro",
    "desktop": {
      "Name": "AT Music Pro",
      "Comment": "Premium music player with Last.fm and YouTube integration",
      "Categories": "Audio;Music;Player;AudioVideo;",
      "StartupWMClass": "at-music-pro"
    }
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0"
    ]
  },
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "nodeGypRebuild": false,
  "flatpak": {
    "runtime": "org.freedesktop.Platform",
    "runtimeVersion": "23.08",
    "sdk": "org.freedesktop.Sdk",
    "branch": "stable",
    "finishArgs": [
      "--share=network",
      "--share=ipc",
      "--socket=x11",
      "--socket=wayland",
      "--socket=pulseaudio",
      "--device=dri",
      "--filesystem=home:rw"
    ]
  },
  "snap": {
    "publish": ["github"],
    "confinement": "strict",
    "grade": "stable",
    "summary": "Premium music player with Last.fm and YouTube integration",
    "plugs": [
      "default",
      "home",
      "network",
      "network-bind",
      "audio-playback",
      "pulseaudio",
      "opengl",
      "removable-media"
    ]
  },
  "snap": {
    "confinement": "strict",
    "grade": "stable",
    "summary": "Premium music player with Last.fm and YouTube integration",
    "plugs": [
      "default",
      "home",
      "network",
      "network-bind",
      "audio-playback",
      "pulseaudio",
      "opengl",
      "removable-media"
    ]
  }
}
