// @see - https://www.electron.build/configuration/configuration
// Icons come from build/ (generated from public/app_icon.png by scripts/generate-icons.py).
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.atmusic.pro",
  "productName": "AT Music Pro",
  "copyright": "Copyright © 2026 Atish Ak Sharma",
  "afterPack": "./scripts/afterPack.cjs",
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*",
    "node_modules/bindings/**/*",
    "node_modules/file-uri-to-path/**/*"
  ],
  // Rebuild native modules (better-sqlite3) for each target arch
  "npmRebuild": true,
  "directories": {
    "buildResources": "build",
    "output": "release/${version}"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "!**/*.map"
  ],
  "extraResources": [
    { "from": "build/icon.png", "to": "app_icon.png" },
    { "from": "build/icon.ico", "to": "app_icon.ico" },
    { "from": "bin", "to": "bin", "filter": ["**/*"] }
  ],
  "artifactName": "AT-Music-Pro-${version}-${os}-${arch}.${ext}",

  // ───────────────────────────── Windows ─────────────────────────────
  "win": {
    "icon": "build/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "msi", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] },
      { "target": "zip", "arch": ["x64"] },
      { "target": "7z", "arch": ["x64"] }
    ],
    "legalTrademarks": "AT Music Pro"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AT Music Pro",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "artifactName": "AT-Music-Pro-${version}-win-${arch}-Setup.${ext}"
  },
  "msi": {
    "oneClick": false,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AT Music Pro",
    "artifactName": "AT-Music-Pro-${version}-win-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "AT-Music-Pro-${version}-win-${arch}-Portable.${ext}"
  },

  // ───────────────────────────── macOS ─────────────────────────────
  "mac": {
    "icon": "build/icon.icns",
    "category": "public.app-category.music",
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] },
      { "target": "pkg", "arch": ["x64", "arm64"] }
    ],
    // Ad-hoc signature: required for Apple Silicon to launch unsigned builds
    "identity": "-",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Not used. Declared for audio APIs only.",
      "LSApplicationCategoryType": "public.app-category.music"
    }
  },
  "dmg": {
    "icon": "build/icon.icns",
    "title": "AT Music Pro ${version}",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },
  "pkg": {
    "installLocation": "/Applications",
    "allowAnywhere": false,
    "isRelocatable": false
  },

  // ───────────────────────────── Linux ─────────────────────────────
  "linux": {
    "icon": "build/icons",
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] },
      { "target": "rpm", "arch": ["x64"] },
      { "target": "pacman", "arch": ["x64"] },
      { "target": "snap", "arch": ["x64"] },
      { "target": "tar.gz", "arch": ["x64"] }
    ],
    "category": "AudioVideo",
    "executableName": "at-music-pro",
    "synopsis": "Premium music player",
    "description": "Premium music player with Last.fm and YouTube integration",
    "maintainer": "Atish Ak Sharma <mail@atishaksharma.com>",
    "vendor": "Atish Ak Sharma",
    "desktop": {
      "Name": "AT Music Pro",
      "Comment": "Premium music player with Last.fm and YouTube integration",
      "Categories": "Audio;Music;Player;AudioVideo;",
      "StartupWMClass": "at-music-pro",
      "Icon": "at-music-pro",
      "Keywords": "music;player;audio;youtube;lyrics;"
    }
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0"
    ],
    "recommends": ["ffmpeg", "yt-dlp"],
    "priority": "optional",
    "afterInstall": "scripts/postinst.sh"
  },
  "rpm": {
    "depends": ["gtk3", "libnotify", "nss", "libXScrnSaver", "libXtst", "xdg-utils", "at-spi2-core", "libuuid"],
    "afterInstall": "scripts/postinst.sh"
  },
  "pacman": {
    "depends": ["gtk3", "libnotify", "nss", "libxss", "libxtst", "xdg-utils", "at-spi2-core", "util-linux-libs"],
    "afterInstall": "scripts/postinst.sh"
  },
  "snap": {
    "confinement": "strict",
    "grade": "stable",
    "summary": "Premium music player with Last.fm and YouTube integration",
    "plugs": [
      "default",
      "home",
      "network",
      "network-bind",
      "audio-playback",
      "pulseaudio",
      "opengl",
      "removable-media"
    ]
  },

  "publish": null
}
